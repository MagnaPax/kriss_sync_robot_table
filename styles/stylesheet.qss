/* styles/stylesheet.qss: 상태바 및 기타 UI 스타일 정의 */
/* 
----------------------------------------
        메인 윈도우 스타일
---------------------------------------- 
*/
/* 상태바 아이템 테두리 제거 (구분선 없애기) */
QStatusBar::item {
    border: none;
}


/* 연결 끊김 상태 */
QLabel#status_label[status="disconnected"] { 
    background-color: #DC3545;
    color: white; 
    padding: 5px;
    border-radius: 3px;
    font-weight: bold; 
}

/* 연결 중 상태 */
QLabel#status_label[status="connecting"] { 
    background-color: #FFC107; 
    color: black; 
    padding: 5px;
    border-radius: 3px;
    font-weight: bold; 
} 

/* 연결됨 상태 */
QLabel#status_label[status="connected"] { 
    background-color: #28A745; 
    color: white; 
    padding: 5px;
    border-radius: 3px;
    font-weight: bold; 
}






/* --------------------------------------------------
        스플래시 스크린 (Splash Screen) 스타일
------------------------------------------------------ 
*/

/* 메인 배경 (테두리 둥글게, 외곽선) */
QWidget#splash_background {
    background-color: #2D2D2D;
    border: 2px solid #4CAF50;
    border-radius: 10px;
}

/* 타이틀 라벨 */
QLabel#splash_title {
    color: white;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 15px;
    background-color: transparent;
}

/* 상태 메시지 라벨 */
QLabel#splash_status {
    color: #CCCCCC;
    font-size: 13px;
    margin-bottom: 5px;
    background-color: transparent;
}

/* 프로그레스 바 */
QProgressBar#splash_progress {
    border: 2px solid grey;
    border-radius: 5px;
    text-align: center;
    background-color: #3D3D3D;
    color: white;
    font-weight: bold;
}

QProgressBar#splash_progress::chunk {
    background-color: #4CAF50;
    width: 10px;
}







/* 
----------------------------------------
    다이얼로그 스타일 (Dialog Styles)
---------------------------------------- 
*/
/* 공통 다이얼로그 프레임 */
QDialog {
    background-color: #2D2D2D;
    border: 2px solid #4CAF50;
    border-radius: 10px;
}

/* 다이얼로그 내부 라벨 */
QDialog QLabel {
    color: #334155;
    font-size: 14px;
    background-color: transparent;
}

/* 로딩 메시지 */
QLabel#loading_label {
    font-weight: 600;
    letter-spacing: 0.2px;
    padding: 6px 10px;
}

/* ---------- 타입별 톤 (아주 은은하게) ---------- */

QDialog[type="info"] {
    border-color: #b6ccf3;
}

/* ==============================
   Frameless Loading Dialog Card
   ============================== */
/* 메인 배경 (테두리 둥글게, 외곽선) */
QWidget#loading_dialog {
    background-color: #2D2D2D;
    border: 2px solid #4CAF50;
    border-radius: 10px;
}

/* 실제 카드(보이는 부분) */
QWidget#loading_bg {
    /* 배경색 */
    background-color: #54585d;
    
    /* 테두리 */
    border: 5px solid #3b4a5f;
    border-radius: 12px;

    /* 안쪽 라인 느낌(테두리 또렷 + 고급감) */
    outline: 1px solid #2b3748;             /* Qt에서 outline이 먹히는 경우가 많음 */
    outline-offset: -2px;
}

/* 텍스트: 다크 배경에 맞는 밝은 슬레이트 */
QLabel#loading_label {
    color: #e5e7eb;                          /* gray-200 */
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2px;
    padding: 6px 10px;
}

/* 타입별 테두리 */
QWidget#loading_bg[type="success"] {
    border-color: #7f8f88;
}

QWidget#loading_bg[type="warning"] {
    border-color: #bb8c14;
}

QWidget#loading_bg[type="error"] {
    border-color: #c02237;
}





/* 
----------------------------------------
            패널 스타일
---------------------------------------- 
*/

/* 왼쪽 패널 (left_panel) */
QWidget#left_panel {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #ffffff,
        stop:1 #f1f4f8
    );
    border: 1px solid #d1d7de;
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}


/* 중앙 패널 (center_panel) */
QWidget#center_panel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ffffff, stop:1 #f8f9fa);
    border: 1px solid #ced4da;
    border-radius: 6px;
    padding: 8px;
    margin: 4px;
}

/* 오른쪽 패널 (right_panel) */
QWidget#right_panel {
    background: qlineargradient(x1:1, y1:0, x2:0, y2:1,
                                stop:0 #e2e8f0, stop:1 #cbd5e1);
    border: 1px solid #94a3b8;
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}




/* 
----------------------------------------
        버튼 스타일 (QPushButton)
---------------------------------------- 
*/

/* 1. 일반 버튼 (보라색) */
/* 사용법: button.setProperty("type", "general") */
QPushButton[type="general"] {
    background-color: #6f42c1; /* 보라색 배경 */
    color: #F0F0F0;
    font-weight: bold;
    border: 1px solid #5a359e; /* 살짝 어두운 테두리 */
    border-radius: 4px; /* 기존 패널과 일치 */
    padding: 5px 10px; /* 상하 5px, 좌우 10px */
}

QPushButton[type="general"]:hover {
    background-color: #8558d6; /* 더 밝은 보라색 */
    border-color: #6f42c1;
}

QPushButton[type="general"]:pressed {
    background-color: #5a359e; /* 더 어두운 보라색 */
    border-color: #4a2c82;
}


/* 2. 특수/주요 버튼 (파란색) */
/* 사용법: button.setProperty("type", "special") */
QPushButton[type="special"] {
    background-color: #5D9CEC; /* 파스텔 블루 */
    color: #F0F0F0;
    font-weight: bold;
    border: 1px solid #4A89DC;  /* 약간 진한 파스텔 테두리 */
    border-radius: 4px;
    padding: 6px 10px;
}

QPushButton[type="special"]:hover {
    background-color: #4A89DC;  /* 호버 시 조금 더 진해짐 */
    border-color: #5D9CEC;
}

QPushButton[type="special"]:pressed {
    background-color: #0069d9;
    border-color: #005cbf;
}


/* 3. Emergency Stop 버튼 (빨간색) */
/* 사용법: button.setObjectName("emergency_button") */
QPushButton#emergency_button {
    background-color: #DC3545; /* 기존 'disconnected'와 동일한 강조색 */
    color: #F0F0F0;
    font-weight: bold;
    font-size: 16px; /* 폰트 크기 증가 (14px -> 16px) */
    min-height: 60px; /* 버튼 높이 증가 */
    border: 1px solid #b02a37;
    border-radius: 4px;
    padding: 8px 15px;
}

QPushButton#emergency_button:hover {
    background-color: #e44d5c;
    border-color: #DC3545;
}

QPushButton#emergency_button:pressed {
    background-color: #b02a37;
    border-color: #9a2430;
}

/* 4. 버튼 비활성화 공통 스타일 */
QPushButton:disabled {
    background-color: #E0E0E0; /* 밝은 회색으로 비활성화 표시 */
    color: #999999;           /* 텍스트 흐리게 */
    border: 1px solid #CCCCCC;
}


/* 
----------------------------------------
            위젯 공통 스타일
---------------------------------------- 
*/
/* QDoubleSpinBox 버튼 초기화 */
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #ced4da;
    border-top-right-radius: 4px;
    background-color: #f8f9fa;
    min-width: 1em; /* 최소 너비 */
    min-height: 1em; /* 최소 높이 */
}
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #ced4da;
    border-bottom-right-radius: 4px;
    background-color: #f8f9fa;
    min-width: 1em; /* 최소 너비 */
    min-height: 1em; /* 최소 높이 */
}
/* 호버 및 프레스 상태 */
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #e9ecef;
}
QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: #dee2e6;
}
/* 화살표(아이콘) */
QDoubleSpinBox::up-arrow {
    image: url(none);
    width: 7px;
    height: 7px;
    border-left: 2px solid #666;
    border-top: 2px solid #666;
    margin-top: 2px;
}
QDoubleSpinBox::down-arrow {
    image: url(none);
    width: 7px;
    height: 7px;
    border-left: 2px solid #666;
    border-bottom: 2px solid #666;
    margin-bottom: 2px;
}


/* 메인 그룹박스 초기화 */
QGroupBox {
    border: 1px solid #94a3b8; /* 차분한 회색 테두리 */
    border-radius: 6px;
    margin-top: 20px; /* 제목 공간 확보 */
    font-weight: bold;
    color: #333333; /* 제목 글자색 (어두운 색) */
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left; /* 제목 왼쪽 정렬 */
    padding: 0 10px;
    background-color: transparent; /* 배경 투명 */
}


/* QLabel 초기화 (투명 배경, 테두리 없음) */
QLabel {
    background: transparent;
    border: none;
}


/* 
----------------------------------------
        개발 위젯 스타일
---------------------------------------- 
*/

/* TargetPositionWidget */
/* 내부 섹션 테두리 제거 */
#target_position_widget QFrame#section_edit_macro, 
#target_position_widget QFrame#section_coordinate, 
#target_position_widget QFrame#section_robot_coordinate, 
#target_position_widget QFrame#section_turtable_coordinate, 
#target_position_widget QFrame#section_macro_buttons, 
#target_position_widget QFrame#section_go_to, 
#target_position_widget QFrame#section_feed_rate {
    border: none;
    background: transparent;
}

/* 라벨 (X, Y, Z, Feed Rate 등) 스타일 강화 (가독성 확보) */
#target_position_widget QLabel {
    font-weight: bold;
    color: #333333; /* 어두운 회색 (가독성) */
    padding-bottom: 10px; /* 그룹박스 내부 하단에 여백 추가 */
    min-width: 30px; /* 최소 너비 */
    min-height: 20px; /* 최소 높이 */
}

/* 입력창 (QLineEdit, QDoubleSpinBox) 스타일 */
#target_position_widget QLineEdit {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px;
    background-color: #ffffff; /* 흰색 배경 */
    color: #333333; /* 짙은 글자색 */
    font-size: 14px;
    selection-background-color: #5D9CEC;
    min-width: 30px; /* 최소 너비 */
    min-height: 20px; /* 최소 높이 */
}

#target_position_widget QDoubleSpinBox {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px;
    padding-right: 25px; /* 버튼 영역 확보 */
    background-color: #ffffff; /* 흰색 배경 */
    color: #333333; /* 짙은 글자색 */
    font-size: 14px;
    selection-background-color: #5D9CEC;
    min-width: 30px; /* 최소 너비 */
    min-height: 20px; /* 최소 높이 */
}

#target_position_widget QDoubleSpinBox:focus {
    border: 2px solid #5D9CEC; /* 포커스 시 파란 테두리 */
}


/* TaskManagerWidget 전용 스타일 */
/* 버튼은 py 코드 setProperty("type", "general")에 의해 기존의 보라색 버튼 스타일이 자동으로 적용 */
/* 정보 타이틀 라벨 (Feed, Runtime) - 하늘색 강조 */
#task_manager_widget QLabel#info_title {
    color: #4FC1E9;  /* 기존 인라인 스타일 색상 */
    font-weight: bold;
    font-size: 13px;
}

/* 정보 값 라벨 (숫자) - 굵게 */
#task_manager_widget QLabel#info_value {
    color: #333333;
    font-weight: bold;
    font-size: 13px;
    margin-right: 5px;
}

/* 파일명 라벨 - 일반 텍스트 */
#task_manager_widget QLabel#filename_label {
    color: #333333;
    font-weight: normal;
}


/* WaypointsWidget (QTableWidget) 스타일 */
/* 1. 그룹박스 스타일 */
#waypoints_groupbox {
    border: 1px solid #94a3b8;
    border-radius: 6px;
    margin-top: 20px;
    font-weight: bold;
    color: #333333;
}

#waypoints_groupbox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    background-color: transparent;
}

/* 2. 테이블 기본 스타일 */
/* 컨테이너에 그라데이션 배경 적용 (두 테이블 뒤에 깔림) */
#waypoints_container {
    background: qlineargradient(
        x1:1, y1:0, x2:0, y2:1,
        stop:0 #e2e8f0, stop:1 #cbd5e1
    );
    border: 1px solid #ced4da;
    border-radius: 4px;
}

#waypoints_widget QTableView {
    color: black;
    background-color: transparent; /* 투명하게 해서 컨테이너 배경이 보이도록 */
    border: none; /* 테두리는 컨테이너가 담당 */
    gridline-color: #e0e0e0;     /* 격자 색상 (연한 회색) */
    selection-background-color: #C7DBF8; /* 현재 진행(선택) row 색깔 */
    selection-color: #000000;            /* 검은색 글자 */
}

/* 3. 헤더 (Header) 스타일 */
#waypoints_widget QHeaderView::section {
    background-color: #d1d9e6;
    color: #495057;              /* 헤더 글자색 (진한 회색) */
    padding: 1px;
    border: none;
    border-right: 1px solid #dee2e6;
    border-bottom: 1px solid #dee2e6;
    font-weight: bold;
}

/* 4. 줄무늬 (Alternating Row Colors) */
/* QTableView 속성 setAlternatingRowColors(True)일 때 적용됨 */
#waypoints_widget QTableView::item {
    color: #333333;
    padding: 4px; /* 셀 내부 여백 */
    background-color: #f3f6fa;  /* 모든 행 배경색 */
    border-bottom: 1px solid #e0e0e0; /* 행 구분선 추가 */
}

#waypoints_widget QTableView::item:alternate {
    background-color: #f3f6fa; /* 짝수 행도 동일하게 */
}

/* 고정 테이블 스타일링 (경계면 자연스럽게) */
#frozen_table {
    border-right: 1px solid #d0d0d0; /* ID 컬럼 구분선 */
}

/* 
    [Scrollbar Design for Perfect Alignment]
    고정 테이블과 메인 테이블의 스크롤바 "높이"를 14px로 강제 통일하여
    스크롤바 유무에 따른 행(Row) 어긋남을 방지한다.
*/

/* 1. 공통 스크롤바 스타일 (메인 테이블에 보일 디자인) */
#waypoints_widget QScrollBar:horizontal {
    background: #f1f3f5;
    height: 14px; /* 높이 고정 중요 */
    margin: 0;
    border: none;
    border-radius: 7px;
}
#waypoints_widget QScrollBar::handle:horizontal {
    background: #c1c9d0;
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}
#waypoints_widget QScrollBar::handle:horizontal:hover {
    background: #aab2bd;
}
#waypoints_widget QScrollBar::add-line:horizontal, 
#waypoints_widget QScrollBar::sub-line:horizontal {
    background: none;
    border: none;
    width: 0px;
}
#waypoints_widget QScrollBar::add-page:horizontal, 
#waypoints_widget QScrollBar::sub-page:horizontal {
    background: none;
}


/* 2. 고정 테이블 스크롤바 숨김 (Override) */
/* 높이는 위에서 상속받아 14px로 유지되지만, 색상을 투명하게 변경 */
#frozen_table QScrollBar:horizontal {
    background: transparent;
    height: 14px; /* 메인 테이블과 높이 일치 필수 (정렬 유지) */
    border: none;
}

/* 핸들(Bar) 투명화 및 호버 효과 제거 */
#frozen_table QScrollBar::handle:horizontal,
#frozen_table QScrollBar::handle:horizontal:hover,
#frozen_table QScrollBar::handle:horizontal:pressed {
    background: transparent;
    border: none;
}

/* 화살표 버튼 투명화 및 공간 제거 */
#frozen_table QScrollBar::add-line:horizontal,
#frozen_table QScrollBar::sub-line:horizontal,
#frozen_table QScrollBar::add-line:horizontal:hover, 
#frozen_table QScrollBar::sub-line:horizontal:hover {
    background: transparent;
    border: none;
    width: 0px;
}

/* 빈 공간(Page) 투명화 */
#frozen_table QScrollBar::add-page:horizontal, 
#frozen_table QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
}


#waypoints_widget QTableView::item:selected {
    background-color: #B0C4DE; /* 선택된 행 (위의 selection-background-color와 일치) */
    color: #000000;
}

/* 마우스 호버 시 행 스타일 */
#waypoints_widget QTableView::item:hover {
    background-color: #e3e8f0; /* 아주 연한 회색 */
    color: #000000;            /* 호버 시 완전 검은색 */
}

/* 짝수/홀수 행 배경색은 QSS에서 alternate-background-color 속성으로 제어 */
#waypoints_widget QTableView {
    alternate-background-color: #ffffff; /* 줄무늬 효과 제거 (흰색 통일) */
}

/* 
    [Waypoints Result Status Colors]
    Delegate에서 Dummy QLabel을 사용하여 이 스타일을 읽어온다.
    usage="waypoint_result" 속성을 가진 라벨을 통해 색상을 매핑한다.
*/
QLabel[usage="waypoint_result"][status="processed"], 
QLabel[usage="waypoint_result"][status="success"],
QLabel[usage="waypoint_result"][status="completed"] {
    background-color: #E8F5E9; /* 연한 초록색 배경 */
    color: #2E7D32;            /* 진한 초록색 글자 */
    font-weight: bold;
}

QLabel[usage="waypoint_result"][status="fail"],
QLabel[usage="waypoint_result"][status="error"],
QLabel[usage="waypoint_result"][status="failed"] {
    background-color: #FFEBEE; /* 연한 빨간색 배경 */
    color: #C62828;            /* 진한 빨간색 글자 */
    font-weight: bold;
}

QLabel[usage="waypoint_result"][status="unprocessed"],
QLabel[usage="waypoint_result"][status="wait"],
QLabel[usage="waypoint_result"][status="pending"] {
    background-color: #eef2f7;
    color: #475569;
}



/* WorldCoordinatesWidget & UserCoordinatesWidget 스타일 */
#world_coordinates_widget QGroupBox {
    padding-bottom: 13px; /* 그룹박스 내부 하단에 여백 추가 */
}

/* QLabel 초기화 (투명 배경, 테두리 없음) */
#world_coordinates_widget QLabel {
    background: transparent;
    border: none;
}


/* [이름] 라벨 (예: "Robot X :", "Tool Rev :") */
#world_coordinates_widget QLabel#wc_name,
#user_coordinates_widget QLabel#wc_name {
    font-weight: normal;
    color: #555555;
    font-size: 12px;
    min-width: 30px;   /* 최소 너비 */
    min-height: 20px;  /* 최소 높이 */
}

/* [값] 라벨 (숫자 데이터) */
#world_coordinates_widget QLabel#wc_value,
#user_coordinates_widget QLabel#wc_value {
    font-weight: bold;
    color: #2D2D2D;
    font-family: 'Consolas', 'Monospace', 'Courier New'; /* 고정폭 폰트 적용 */
    font-size: 14px;
    background-color: #f1f3f5; /* 값 영역 살짝 강조 */
    padding: 2px 5px;
    border-radius: 3px;
    min-width: 100px;   /* 최소 너비 */
    min-height: 20px;  /* 최소 높이 */
}

/* [단위] 라벨 (mm, deg, RPM 등) */
#world_coordinates_widget QLabel#wc_unit,
#user_coordinates_widget QLabel#wc_unit {
    color: #777777;
    font-size: 11px;
    font-style: italic;
    min-width: 30px;   /* 최소 너비 */
    min-height: 20px;  /* 최소 높이 */
}





/* ServoControlWidget 전용 스타일 */
#servo_control_widget QLabel {
    font-weight: bold;
    color: #333333;
}

#servo_control_widget QDoubleSpinBox {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px;
    padding-right: 25px; /* 버튼 영역 확보 */
    background-color: #ffffff;
    color: #333333;
    font-size: 14px;
    selection-background-color: #5D9CEC;
}

#servo_control_widget QDoubleSpinBox:focus {
    border: 2px solid #5D9CEC;
}




/* WaypointsWidget 스타일 */
/* 움푹 파인(Sunken) 효과 */
QProgressBar#main_progress_bar {
    border: none;
    background-color: #e6e6e6; /* 기본 배경 */
    border-radius: 12px;       /* 둥근 캡슐 형태 */
    text-align: center;
    color: #333333;
    font-weight: bold;
    
    /* 입체감을 위한 내부 그림자 시뮬레이션 (Neumorphism Inner Shadow) */
    /* 상단/좌측: 어둡게, 하단/우측: 밝게 */
    border-top: 2px solid #d1d1d1;
    border-left: 2px solid #d1d1d1;
    border-bottom: 2px solid #ffffff;
    border-right: 2px solid #ffffff;
}

QProgressBar#main_progress_bar::chunk {
    /* 진행 바 색상 */
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0, 
        stop:0 #E0C3FC, stop:1 #8EC5FC
    );
    border-radius: 10px;
    margin: 3px; /* 트랙 안쪽에 떠 있는 느낌 */
}

/* MacroSettingsDialog 전용 스타일 */
#macro_settings_dialog {
    background-color: #f8f9fa;
    border: 1px solid #ced4da;
    border-radius: 8px;
}

#macro_settings_dialog QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d1d7de;
    border-radius: 6px;
    margin-top: 15px;
    padding-top: 10px;
}

#macro_settings_dialog QGroupBox::title {
    color: #4A89DC;
    font-size: 14px;
    font-weight: bold;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    left: 10px;
}

#macro_settings_dialog QLineEdit#macro_name_input {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 5px;
    background-color: #ffffff;
    color: #333333;
}

#macro_settings_dialog QLineEdit#macro_name_input:focus {
    border: 2px solid #5D9CEC;
}

#macro_settings_dialog QDoubleSpinBox[objectName^="macro_spin_"] {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 5px;
    background-color: #ffffff;
    min-width: 80px;
}

#macro_settings_dialog QDoubleSpinBox[objectName^="macro_spin_"]:focus {
    border: 2px solid #5D9CEC;
}

#macro_settings_dialog QPushButton#macro_save_btn {
    background-color: #5D9CEC;
    color: white;
    font-weight: bold;
    border-radius: 4px;
    padding: 6px 15px;
    min-width: 80px;
}

#macro_settings_dialog QPushButton#macro_save_btn:hover {
    background-color: #4A89DC;
}

#macro_settings_dialog QPushButton#macro_save_btn:pressed {
    background-color: #3b6eb0;
}

#macro_settings_dialog QPushButton#macro_save_btn:disabled {
    background-color: #e0e0e0;
    color: #999999;
}




/* Turntable Widget Styling */
#turntable_gauge_painter {
    qproperty-circleColor: #007BFF;
    qproperty-scaleLineColor: gray;
    qproperty-scaleTextColor: #666666;
    qproperty-arrowColor: #3498db;
    /* 툴의 위치 (Tool Position) */
    qproperty-toolPositionColor: red;
    /* Material Cut Trajectory (실제 소재 가공 궤적) 시각화 색상 */
    qproperty-materialCutTrajectoryColor: #D3D3D3;
}

#turntable_readout {
    font-size: 18px; 
    font-weight: bold; 
    margin-top: 5px;
}

/* styles/stylesheet.qss: 상태바 및 기타 UI 스타일 정의 */

/* 연결 끊김 상태 */
QLabel#status_label[status="disconnected"] { 
    background-color: #DC3545;
    color: white; 
    padding: 5px;
    border-radius: 3px;
    font-weight: bold; 
}

/* 연결 중 상태 */
QLabel#status_label[status="connecting"] { 
    background-color: #FFC107; 
    color: black; 
    padding: 5px;
    border-radius: 3px;
    font-weight: bold; 
} 

/* 연결됨 상태 */
QLabel#status_label[status="connected"] { 
    background-color: #28A745; 
    color: white; 
    padding: 5px;
    border-radius: 3px;
    font-weight: bold; 
}




/* 
   ----------------------------------------
   패널 스타일
   ---------------------------------------- 
*/

/* 왼쪽 패널 (left_panel) */
QWidget#left_panel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ffffff, stop:1 #f8f9fa);
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}

/* 중앙 패널 (center_panel) */
QWidget#center_panel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ffffff, stop:1 #f8f9fa);
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}

/* 오른쪽 패널 (right_panel) */
QWidget#right_panel {
    background: qlineargradient(x1:1, y1:0, x2:0, y2:1,
                                stop:0 #e2e8f0, stop:1 #cbd5e1);
    border: 1px solid #94a3b8;
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}




/* 
   ----------------------------------------
   위젯 스타일
   ---------------------------------------- 
*/

/* CurrentStateWidget 스타일 */
/* QWidget#current_state_widget QLabel {
    color: #808080;
    font-size: 14px;
    border: none; 
    background-color: transparent; 
} */


/* CurrentStateWidget 스타일 */
#current_state_widget {
    background-color: #2E2E2E;
    border-radius: 5px;
}

/* CurrentStateWidget 내부의 RPM/Speed 라벨 */
#rpm_speed_label {
    font-size: 16px;
    font-weight: bold;
    color: #E0E0E0;
    background-color: #3A3A3A;
    padding: 5px;
    border-radius: 3px;
}


/* ----------------------------------------
   버튼 스타일 (QPushButton)
   ---------------------------------------- 
*/

/* 1. 일반 버튼 (보라색) */
/* 사용법: button.setProperty("type", "general") */
QPushButton[type="general"] {
    background-color: #6f42c1; /* 보라색 배경 */
    color: white;
    font-weight: bold;
    border: 1px solid #5a359e; /* 살짝 어두운 테두리 */
    border-radius: 4px; /* 기존 패널과 일치 */
    padding: 5px 10px; /* 상하 5px, 좌우 10px */
}

QPushButton[type="general"]:hover {
    background-color: #8558d6; /* 더 밝은 보라색 */
    border-color: #6f42c1;
}

QPushButton[type="general"]:pressed {
    background-color: #5a359e; /* 더 어두운 보라색 */
    border-color: #4a2c82;
}


/* 2. 특수/주요 버튼 (파란색) */
/* 사용법: button.setProperty("type", "special") */
QPushButton[type="special"] {
    background-color: #007BFF; /* 밝은 파란색 */
    color: white;
    font-weight: bold;
    border: 1px solid #0069d9;
    border-radius: 4px;
    padding: 5px 10px;
}

QPushButton[type="special"]:hover {
    background-color: #008bff;
    border-color: #007BFF;
}

QPushButton[type="special"]:pressed {
    background-color: #0069d9;
    border-color: #005cbf;
}


/* 3. Emergency Stop 버튼 (빨간색) */
/* 사용법: button.setObjectName("emergency_button") */
QPushButton#emergency_button {
    background-color: #DC3545; /* 기존 'disconnected'와 동일한 강조색 */
    color: white;
    font-weight: bold;
    font-size: 14px; /* 다른 버튼보다 조금 더 크게 */
    border: 1px solid #b02a37;
    border-radius: 4px;
    padding: 8px 15px; /* 다른 버튼보다 더 크게 */
}

QPushButton#emergency_button:hover {
    background-color: #e44d5c;
    border-color: #DC3545;
}

QPushButton#emergency_button:pressed {
    background-color: #b02a37;
    border-color: #9a2430;
}
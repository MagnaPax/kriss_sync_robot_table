/* styles/stylesheet.qss: 상태바 및 기타 UI 스타일 정의 */

/* 연결 끊김 상태 */
QLabel#status_label[status="disconnected"] { 
    background-color: #DC3545;
    color: white; 
    padding: 5px;
    border-radius: 3px;
    font-weight: bold; 
}

/* 연결 중 상태 */
QLabel#status_label[status="connecting"] { 
    background-color: #FFC107; 
    color: black; 
    padding: 5px;
    border-radius: 3px;
    font-weight: bold; 
} 

/* 연결됨 상태 */
QLabel#status_label[status="connected"] { 
    background-color: #28A745; 
    color: white; 
    padding: 5px;
    border-radius: 3px;
    font-weight: bold; 
}




/* 
   ----------------------------------------
   패널 스타일
   ---------------------------------------- 
*/

/* 왼쪽 패널 (left_panel) */
QWidget#left_panel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ffffff, stop:1 #f8f9fa);
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}

/* 중앙 패널 (center_panel) */
QWidget#center_panel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ffffff, stop:1 #f8f9fa);
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}

/* 오른쪽 패널 (right_panel) */
QWidget#right_panel {
    background: qlineargradient(x1:1, y1:0, x2:0, y2:1,
                                stop:0 #e2e8f0, stop:1 #cbd5e1);
    border: 1px solid #94a3b8;
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}




/* 
   ----------------------------------------
   위젯 스타일
   ---------------------------------------- 
*/


/* CurrentStateWidget 스타일 */
#current_state_widget {
    background-color: #2E2E2E;
    border-radius: 5px;
}

/* CurrentStateWidget 내부의 RPM/Speed 라벨 */
#rpm_speed_label {
    font-size: 16px;
    font-weight: bold;
    color: #E0E0E0;
    background-color: #3A3A3A;
    padding: 5px;
    border-radius: 3px;
}

/* TargetPositionWidget 전용 스타일 */
/* 메인 그룹박스 (Target Position) 테두리는 보이게 하기 */
#target_position_widget > QGroupBox {
    border: 1px solid #94a3b8; /* 차분한 회색 테두리 */
    border-radius: 6px;
    margin-top: 20px; /* 제목 공간 확보 */
    font-weight: bold;
    color: #333333; /* 제목 글자색 (어두운 색) */
}

#target_position_widget > QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left; /* 제목 왼쪽 정렬 */
    padding: 0 10px;
    background-color: transparent; /* 배경 투명 */
}

/* 내부 섹션 테두리 제거 */
#target_position_widget QFrame#section_edit_macro, 
#target_position_widget QFrame#section_coordinate, 
#target_position_widget QFrame#section_robot_coordinate, 
#target_position_widget QFrame#section_turtable_coordinate, 
#target_position_widget QFrame#section_macro_buttons, 
#target_position_widget QFrame#section_go_to, 
#target_position_widget QFrame#section_feed_rate {
    border: none;
    background: transparent;
}

/* 라벨 (X, Y, Z, Feed Rate 등) 스타일 강화 (가독성 확보) */
#target_position_widget QLabel {
    font-weight: bold;
    color: #333333; /* 어두운 회색 (가독성) */
}

/* 입력창 (QLineEdit, QDoubleSpinBox) 스타일 */
#target_position_widget QLineEdit {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px;
    background-color: #ffffff; /* 흰색 배경 */
    color: #333333; /* 짙은 글자색 */
    font-size: 14px;
    selection-background-color: #5D9CEC;
}

#target_position_widget QDoubleSpinBox {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px;
    padding-right: 25px; /* 버튼 영역 확보 */
    background-color: #ffffff; /* 흰색 배경 */
    color: #333333; /* 짙은 글자색 */
    font-size: 14px;
    selection-background-color: #5D9CEC;
}

#target_position_widget QDoubleSpinBox:focus {
    border: 2px solid #5D9CEC; /* 포커스 시 파란 테두리 */
}

/* SpinBox 버튼 스타일 (공통 적용 가능하도록 추가) */
#target_position_widget QDoubleSpinBox::up-button,
#servo_control_widget QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #ced4da;
    border-top-right-radius: 4px;
    background-color: #f8f9fa;
}

#target_position_widget QDoubleSpinBox::down-button,
#servo_control_widget QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #ced4da;
    border-bottom-right-radius: 4px;
    background-color: #f8f9fa;
}

#target_position_widget QDoubleSpinBox::up-button:hover,
#servo_control_widget QDoubleSpinBox::up-button:hover,
#target_position_widget QDoubleSpinBox::down-button:hover,
#servo_control_widget QDoubleSpinBox::down-button:hover {
    background-color: #e9ecef;
}

#target_position_widget QDoubleSpinBox::up-button:pressed,
#servo_control_widget QDoubleSpinBox::up-button:pressed,
#target_position_widget QDoubleSpinBox::down-button:pressed,
#servo_control_widget QDoubleSpinBox::down-button:pressed {
    background-color: #dee2e6;
}

#target_position_widget QDoubleSpinBox::up-arrow,
#servo_control_widget QDoubleSpinBox::up-arrow {
    image: url(none); /* 기본 화살표 대신 텍스트나 간단한 기호 사용 가능하지만, 여기선 기본 보정 */
    width: 7px;
    height: 7px;
    border-left: 2px solid #666;
    border-top: 2px solid #666;
    margin-top: 2px;
}

#target_position_widget QDoubleSpinBox::down-arrow,
#servo_control_widget QDoubleSpinBox::down-arrow {
    width: 7px;
    height: 7px;
    border-left: 2px solid #666;
    border-bottom: 2px solid #666;
    margin-bottom: 2px;
}


/* TaskManagerWidget 전용 스타일 */
/* 버튼은 py 코드 setProperty("type", "general")에 의해 기존의 보라색 버튼 스타일이 자동으로 적용 */
/* 1. 메인 그룹박스 스타일 (TargetPosition과 통일) */
#task_manager_widget > QGroupBox {
    border: 1px solid #94a3b8;
    border-radius: 6px;
    margin-top: 20px;
    font-weight: bold;
    color: #333333;
}

#task_manager_widget > QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    background-color: transparent;
}

/* 2. 정보 타이틀 라벨 (Feed, Runtime) - 하늘색 강조 */
#task_manager_widget QLabel#info_title {
    color: #4FC1E9;  /* 기존 인라인 스타일 색상 */
    font-weight: bold;
    font-size: 13px;
}

/* 3. 정보 값 라벨 (숫자) - 굵게 */
#task_manager_widget QLabel#info_value {
    color: #333333;
    font-weight: bold;
    font-size: 13px;
    margin-right: 5px;
}

/* 4. 파일명 라벨 - 일반 텍스트 */
#task_manager_widget QLabel#filename_label {
    color: #333333;
    font-weight: normal;
}


/* WaypointsWidget (QTableWidget) 스타일 */
/* 1. 그룹박스 스타일 (TargetPosition, TaskManager와 통일) */
#waypoints_groupbox {
    border: 1px solid #94a3b8;
    border-radius: 6px;
    margin-top: 20px;
    font-weight: bold;
    color: #333333;
}

#waypoints_groupbox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    background-color: transparent;
}

/* 2. 테이블 기본 스타일 */
#waypoints_widget QTableWidget {
    color: black;
    background-color: #ffffff;
    gridline-color: #e0e0e0;     /* 격자 색상 (연한 회색) */
    border: 1px solid #ced4da;
    border-radius: 4px;
    selection-background-color: #5D9CEC; /* 선택된 행 배경색 (파란색) */
    selection-color: #ffffff;            /* 선택된 행 글자색 */
}

/* 3. 헤더 (Header) 스타일 */
#waypoints_widget QHeaderView::section {
    background-color: #f8f9fa;   /* 헤더 배경 (아주 연한 회색) */
    color: #495057;              /* 헤더 글자색 (진한 회색) */
    padding: 1px;
    border: 1px solid #dee2e6;
    border-top: none;            /* 상단 테두리 제거 (깔끔하게) */
    font-weight: bold;
}

/* 4. 줄무늬 (Alternating Row Colors) */
/* QTableWidget 속성 setAlternatingRowColors(True)일 때 적용됨 */
#waypoints_widget QTableWidget::item {
    color: #333333;
    padding: 4px; /* 셀 내부 여백 */
}

/* 마우스 호버 시 행 스타일 */
#waypoints_widget QTableWidget::item:hover {
    background-color: #f0f4f8; /* 아주 연한 파란색 */
    color: #000000;            /* 호버 시 완전 검은색 */
}

/* (참고) 짝수/홀수 행 배경색은 QSS에서 alternate-background-color 속성으로 제어 */
#waypoints_widget QTableWidget {
    alternate-background-color: #f1f3f5; /* 연한 회색 줄무늬 */
}


/* WorldCoordinatesWidget 스타일 */

/* 1. 메인 그룹박스 스타일 (통합된 System Coordinates) */
#world_coordinates_widget > QGroupBox {
    border: 1px solid #94a3b8;
    border-radius: 6px;
    margin-top: 20px;
    font-weight: bold;
    color: #333333; /* [cite: 54] */
}

#world_coordinates_widget > QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    background-color: transparent; /* [cite: 55] */
}

/* 2. 섹션 구분용 수평선 (QFrame) */
#world_coordinates_widget QFrame {
    border: 1px solid #ced4da;
    max-height: 1px;
    margin: 5px 2px; /* [cite: 18, 87] */
}

/* 3. [이름] 라벨 (예: "Robot X :", "Tool Rev :") */
#world_coordinates_widget QLabel#wc_name {
    font-weight: normal;
    color: #555555;
    font-size: 12px; /* [cite: 57] */
}

/* 4. [값] 라벨 (숫자 데이터) */
#world_coordinates_widget QLabel#wc_value {
    font-weight: bold;
    color: #2D2D2D;
    font-family: 'Consolas', 'Monospace', 'Courier New'; /* 고정폭 폰트 적용 [cite: 58, 59] */
    font-size: 14px;
    background-color: #f1f3f5; /* 값 영역 살짝 강조 [cite: 53] */
    padding: 2px 5px;
    border-radius: 3px;
}

/* 5. [단위] 라벨 (mm, deg, RPM 등) */
#world_coordinates_widget QLabel#wc_unit {
    color: #777777;
    font-size: 11px;
    font-style: italic; /* [cite: 60] */
}





/* ServoControlWidget 전용 스타일 */
#servo_control_widget > QGroupBox {
    border: 1px solid #94a3b8;
    border-radius: 6px;
    margin-top: 20px;
    font-weight: bold;
    color: #333333;
}

#servo_control_widget > QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    background-color: transparent;
}

#servo_control_widget QLabel {
    font-weight: bold;
    color: #333333;
}

#servo_control_widget QDoubleSpinBox {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px;
    padding-right: 25px; /* 버튼 영역 확보 */
    background-color: #ffffff;
    color: #333333;
    font-size: 14px;
    selection-background-color: #5D9CEC;
}

#servo_control_widget QDoubleSpinBox:focus {
    border: 2px solid #5D9CEC;
}


/* ----------------------------------------
   버튼 스타일 (QPushButton)
   ---------------------------------------- 
*/

/* 1. 일반 버튼 (보라색) */
/* 사용법: button.setProperty("type", "general") */
QPushButton[type="general"] {
    background-color: #6f42c1; /* 보라색 배경 */
    color: #F0F0F0;
    font-weight: bold;
    border: 1px solid #5a359e; /* 살짝 어두운 테두리 */
    border-radius: 4px; /* 기존 패널과 일치 */
    padding: 5px 10px; /* 상하 5px, 좌우 10px */
}

QPushButton[type="general"]:hover {
    background-color: #8558d6; /* 더 밝은 보라색 */
    border-color: #6f42c1;
}

QPushButton[type="general"]:pressed {
    background-color: #5a359e; /* 더 어두운 보라색 */
    border-color: #4a2c82;
}


/* 2. 특수/주요 버튼 (파란색) */
/* 사용법: button.setProperty("type", "special") */
QPushButton[type="special"] {
    background-color: #5D9CEC; /* 파스텔 블루 */
    color: #F0F0F0;
    font-weight: bold;
    border: 1px solid #4A89DC;  /* 약간 진한 파스텔 테두리 */
    border-radius: 4px;
    padding: 6px 10px;
}

QPushButton[type="special"]:hover {
    background-color: #4A89DC;  /* 호버 시 조금 더 진해짐 */
    border-color: #5D9CEC;
}

QPushButton[type="special"]:pressed {
    background-color: #0069d9;
    border-color: #005cbf;
}


/* 3. Emergency Stop 버튼 (빨간색) */
/* 사용법: button.setObjectName("emergency_button") */
QPushButton#emergency_button {
    background-color: #DC3545; /* 기존 'disconnected'와 동일한 강조색 */
    color: #F0F0F0;
    font-weight: bold;
    font-size: 14px; /* 다른 버튼보다 조금 더 크게 */
    border: 1px solid #b02a37;
    border-radius: 4px;
    padding: 8px 15px; /* 다른 버튼보다 더 크게 */
}

QPushButton#emergency_button:hover {
    background-color: #e44d5c;
    border-color: #DC3545;
}

QPushButton#emergency_button:pressed {
    background-color: #b02a37;
    border-color: #9a2430;
}





/* ----------------------------------------
   스플래시 스크린 (Splash Screen) 스타일
   ---------------------------------------- 
*/

/* 메인 배경 (테두리 둥글게, 외곽선) */
QWidget#splash_background {
    background-color: #2D2D2D;
    border: 2px solid #4CAF50;
    border-radius: 10px;
}

/* 타이틀 라벨 */
QLabel#splash_title {
    color: white;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 15px;
    background-color: transparent;
}

/* 상태 메시지 라벨 */
QLabel#splash_status {
    color: #CCCCCC;
    font-size: 13px;
    margin-bottom: 5px;
    background-color: transparent;
}

/* 프로그레스 바 */
QProgressBar#splash_progress {
    border: 2px solid grey;
    border-radius: 5px;
    text-align: center;
    background-color: #3D3D3D;
    color: white;
    font-weight: bold;
}

QProgressBar#splash_progress::chunk {
    background-color: #4CAF50;
    width: 10px;
}




/* 
   ----------------------------------------
   메인 윈도우 스타일
   ---------------------------------------- 
*/
/* 상태바 아이템 테두리 제거 (구분선 없애기) */
QStatusBar::item {
    border: none;
}